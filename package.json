{
  "name": "dsh-context-manager",
  "version": "1.2.0",
  "description": "Explicit context-memory subsystem for DeepSeek Harness: a four-layer memory model (verbatim pins, durable notes, LLM sketch, full-log retrieval) with a malloc-style tool API (context_alloc/free/list) and an on-demand /reset command next to /compact",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "compaction",
    "context-window",
    "agent-memory",
    "malloc"
  ],
  "license": "MIT",
  "author": "edgeseeker7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgeseeker7/dsh-context-manager.git"
  },
  "homepage": "https://github.com/edgeseeker7/dsh-context-manager#readme",
  "bugs": {
    "url": "https://github.com/edgeseeker7/dsh-context-manager/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check lib/ && node --check lib/index.js && node --check lib/engine.js && node --check lib/command.js && node --check lib/malloc.js && node --check lib/history.js && node --check lib/notes.js && node --check lib/lock.js && node --check lib/client.js && node test/smoke.mjs && node test/history.mjs && node test/command.mjs && node test/client-definition.mjs",
    "check:fix": "biome check --write lib/",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-compaction": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.6-alpha.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.6-alpha.1 <0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-brand": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-code-runtime": "0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-compaction-basic": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-home-paths": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-ptc-runtime": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-scope": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-timeout": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.1.6-alpha.1",
    "@deepseek-ai/dsh-user-approval": "0.1.6-alpha.1"
  },
  "packageManager": "pnpm@11.21.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
