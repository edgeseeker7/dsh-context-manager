{
  "name": "dsh-context-reset",
  "version": "0.1.0",
  "description": "On-demand hard context-window reset for DeepSeek Harness: a /reset command next to /compact — no summarization, the model keeps durable notes and retrieves history on demand",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "compaction",
    "context-window",
    "agent-memory"
  ],
  "license": "MIT",
  "author": "edgeseeker7",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edgeseeker7/dsh-context-reset.git"
  },
  "homepage": "https://github.com/edgeseeker7/dsh-context-reset#readme",
  "bugs": {
    "url": "https://github.com/edgeseeker7/dsh-context-reset/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "biome check lib/ && node --check lib/index.js && node --check lib/engine.js && node --check lib/command.js",
    "check:fix": "biome check --write lib/",
    "prepublishOnly": "pnpm run check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-compaction": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-compaction-basic": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.2-rc.1 <0.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <0.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  },
  "packageManager": "pnpm@11.21.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
